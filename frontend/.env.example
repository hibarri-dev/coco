# Server-only secrets: set in Vercel > Project > Settings > Environment Variables.
# Never prefix these with VITE_ (that would ship them to the browser).
STRIPE_SECRET_KEY=sk_test_xxx
# From Stripe > Developers > Webhooks after adding https://<your-domain>/api/stripe-webhook
# with the event checkout.session.completed.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: canonical site URL for Stripe return links (defaults to the request origin).
SITE_URL=
# Where paid orders are forwarded (absolute URL): Hibarri Superadmin > Coco > Forms.
LEADS_ENDPOINT=https://api.hibarri.com/api/coco/leads

# Transactional email (broadcast seat confirmation, white paper) sent by /api/email.
# SMTP login for the coco@hibarri.com mailbox. Port 465 uses TLS, 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=coco@hibarri.com
SMTP_PASS=
EMAIL_FROM="CoCo by Hibarri <coco@hibarri.com>"
# Optional: where replies go (defaults to EMAIL_FROM).
EMAIL_REPLY_TO=

# --- Browser (VITE_) settings -------------------------------------------------
# Hibarri API. Powers Superadmin > Coco: analytics, form submissions, admin-uploaded
# videos and CMS pages at /page/<slug>. Leave empty to run the site standalone.
VITE_API_URL=https://api.hibarri.com/api
# Optional override for form submissions (defaults to <VITE_API_URL>/coco/leads).
VITE_LEADS_ENDPOINT=
# Microsoft Clarity project id.
VITE_CLARITY_ID=

# Fallback broadcast media. Videos marked active in Superadmin > Coco > Videos take priority.
VITE_BROADCAST_VIDEO_URL=
VITE_BROADCAST_PREVIEW_URL=
VITE_BROADCAST_POSTER_URL=
VITE_BROADCAST_DURATION_MIN=75
VITE_WHITEPAPER_URL=

# Server catalog and checkout.
VITE_CATALOG_ENDPOINT=
VITE_CHECKOUT_ENDPOINT=
VITE_EMAIL_ENDPOINT=
VITE_STRIPE_LINK_CORE_32=
VITE_STRIPE_LINK_CORE_64=
VITE_STRIPE_LINK_CORE_192=
VITE_STRIPE_LINK_GPU_4X=

# Wire transfer details shown after a wire order.
VITE_BANK_ACCOUNT_NAME=
VITE_BANK_NAME=
VITE_BANK_ACCOUNT=
VITE_BANK_SWIFT=
