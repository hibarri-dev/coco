{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.hibarri.com/coco/sitemap.xml" },
    { "source": "/((?!api/|assets/|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/((?!api/|assets/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
