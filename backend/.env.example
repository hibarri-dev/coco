PORT=5001
NODE_ENV=development

# Required. Your existing MongoDB (Atlas) connection string; the server refuses to start without it.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/coco?retryWrites=true&w=majority

# Required. Long random string (32+ chars in production), e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Shared secret that allows the Hibarri backend to call /api/admin/* server-to-server
# without a user JWT. Must match COCO_INTERNAL_KEY in the Hibarri backend .env.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COCO_INTERNAL_KEY=


# Stripe (required in production). Webhook endpoint: https://<your-site>/api/webhook/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
#         Developer plans also need: customer.subscription.created, customer.subscription.updated,
#         customer.subscription.deleted, invoice.created, invoice.paid
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Developer plans: recurring monthly Stripe Prices ($5 Hobby, $25 Pro). Usage above the included credit
# is added to the renewal invoice automatically.
STRIPE_PRICE_HOBBY=price_xxx
STRIPE_PRICE_PRO=price_xxx

# Prepaid credits: developers top up (min $20) through Stripe Checkout; usage is charged against the balance
# every 5 minutes and services stop at $0. Server owners are paid weekly (Monday UTC) for usage their
# servers ran, minus CoCo's 20% fee; payouts are approved in Hibarri Superadmin > Coco > Payouts.
# Set BILLING_JOBS=off only on instances that must not run the billing timers (jobs are lock-protected anyway).
BILLING_JOBS=

# Usage metering. Leave DEV_RUNTIME empty to simulate usage for active services (demo/dev).
# Payouts settled from simulated usage are flagged "simulated" in Superadmin; never pay those out.
# Set DEV_RUNTIME=external when a real orchestrator posts usage to POST /api/dev/usage/ingest
# with header `x-meter-key: <METER_INGEST_KEY>`.
DEV_RUNTIME=
METER_INGEST_KEY=

# Public site URL(s), comma-separated. The first one is used for Stripe return links and email links.
CLIENT_URL=http://localhost:5173

# Number of proxies in front of the backend, so rate limits see the visitor's IP, not a proxy's.
# 2 = Vercel rewrite + your host's load balancer (Render, Railway, Fly...). 1 = only the host's load balancer.
TRUST_PROXY=2

# Store: live servers from Ingram Micro Xvantage (developer.ingrammicro.com). Leave empty to show the sample catalog.
INGRAM_CLIENT_ID=
INGRAM_CLIENT_SECRET=
INGRAM_CUSTOMER_NUMBER=
INGRAM_COUNTRY_CODE=US
INGRAM_SENDER_ID=
# Sandbox: https://api.ingrammicro.com:443/sandbox
INGRAM_API_BASE=https://api.ingrammicro.com:443
INGRAM_TOKEN_URL=https://api.ingrammicro.com:443/oauth/oauth30/token
INGRAM_SEARCH_KEYWORD=server
INGRAM_CATEGORY=
# Comma-separated, e.g. Lenovo,Dell,HPE
INGRAM_VENDORS=

# Store backup: TD SYNNEX partner API, used when Ingram Micro fails or returns nothing.
# TD SYNNEX issues these URLs per region/program.
TDSYNNEX_API_BASE=
TDSYNNEX_TOKEN_URL=
TDSYNNEX_PRODUCTS_PATH=/products
TDSYNNEX_CLIENT_ID=
TDSYNNEX_CLIENT_SECRET=
TDSYNNEX_CUSTOMER_NUMBER=
TDSYNNEX_SEARCH_KEYWORD=server

# Paid orders and new sign-ups are forwarded here (Hibarri Superadmin > Coco > Forms, then synced to MailLady).
LEADS_ENDPOINT=https://api.hibarri.com/api/coco/leads

# Transactional email sent by /api/email (broadcast seat confirmation, white paper).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=coco@coco.hibarri.com
SMTP_PASS=
EMAIL_FROM="CoCo by Hibarri <coco@coco.hibarri.com>"
EMAIL_REPLY_TO=
# Lifecycle emails (welcome, purchase, configuration, live, first user) are edited in Hibarri Superadmin > Coco > Emails.
# Default banner image shown on them (https URL); admins can override it per email.
EMAIL_BANNER_URL=

# PDF invoice attached to the purchase email. Address lines are separated by "|".
INVOICE_SELLER_NAME="Hibarri (Pty) Ltd"
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_EMAIL=
# Shown on unpaid wire-transfer invoices.
INVOICE_BANK_ACCOUNT_NAME=
INVOICE_BANK_NAME=
INVOICE_BANK_ACCOUNT=
INVOICE_BANK_SWIFT=

BROADCAST_TITLE=Real Estate vs Digital Estate
BROADCAST_DURATION_MIN=75
WHITEPAPER_URL=
